{
  "name": "phishguard-outlook",
  "version": "1.0.0",
  "description": "Complément Outlook d'analyse anti-phishing (sans clé d'API, analyse locale)",
  "type": "module",
  "private": true,
  "scripts": {
    "certs": "npx --yes office-addin-dev-certs install",
    "start": "node server.js",
    "test": "node --test test/engine.test.js",
    "validate": "npx --yes office-addin-manifest validate manifest.xml",
    "manifest:prod": "node tools/build-manifest.mjs",
    "update-lists": "node tools/update-blocklists.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
