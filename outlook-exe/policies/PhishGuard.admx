<?xml version="1.0" encoding="utf-8"?>
<!-- PhishGuard pour Outlook : modèle de stratégies de groupe (généré par tools/gen-admx.py). -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="phishguard" namespace="PhishGuard.Policies.PhishGuard" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_PhishGuard" displayName="$(string.SUPPORTED_PhishGuard)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="Cat_PhishGuard" displayName="$(string.Cat_PhishGuard)" />
    <category name="Cat_Company" displayName="$(string.Cat_Company)">
      <parentCategory ref="Cat_PhishGuard" />
    </category>
    <category name="Cat_Usage" displayName="$(string.Cat_Usage)">
      <parentCategory ref="Cat_PhishGuard" />
    </category>
    <category name="Cat_Sources" displayName="$(string.Cat_Sources)">
      <parentCategory ref="Cat_PhishGuard" />
    </category>
  </categories>
  <policies>
    <policy name="ReportAddress" class="Both" displayName="$(string.ReportAddress)" explainText="$(string.ReportAddress_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.ReportAddress)">
      <parentCategory ref="Cat_Company" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <text id="ReportAddress_Value" valueName="ReportAddress" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="CompanyDomains" class="Both" displayName="$(string.CompanyDomains)" explainText="$(string.CompanyDomains_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.CompanyDomains)">
      <parentCategory ref="Cat_Company" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <text id="CompanyDomains_Value" valueName="CompanyDomains" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="Company1" class="Both" displayName="$(string.Company1)" explainText="$(string.Company1_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.Company1)">
      <parentCategory ref="Cat_Company" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <text id="Company1_Value" valueName="Company1" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="Company2" class="Both" displayName="$(string.Company2)" explainText="$(string.Company2_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.Company2)">
      <parentCategory ref="Cat_Company" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <text id="Company2_Value" valueName="Company2" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="Company3" class="Both" displayName="$(string.Company3)" explainText="$(string.Company3_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.Company3)">
      <parentCategory ref="Cat_Company" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <text id="Company3_Value" valueName="Company3" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="InternalRelays" class="Both" displayName="$(string.InternalRelays)" explainText="$(string.InternalRelays_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.InternalRelays)">
      <parentCategory ref="Cat_Company" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <text id="InternalRelays_Value" valueName="InternalRelays" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="TrustedDomains" class="Both" displayName="$(string.TrustedDomains)" explainText="$(string.TrustedDomains_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.TrustedDomains)">
      <parentCategory ref="Cat_Company" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <text id="TrustedDomains_Value" valueName="TrustedDomains" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="SharedBlocklistPath" class="Both" displayName="$(string.SharedBlocklistPath)" explainText="$(string.SharedBlocklistPath_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.SharedBlocklistPath)">
      <parentCategory ref="Cat_Company" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <text id="SharedBlocklistPath_Value" valueName="SharedBlocklistPath" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="ForceSimpleMode" class="Both" displayName="$(string.ForceSimpleMode)" explainText="$(string.ForceSimpleMode_Help)" key="Software\Policies\PhishGuard" valueName="ForceSimpleMode">
      <parentCategory ref="Cat_Usage" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="Language" class="Both" displayName="$(string.Language)" explainText="$(string.Language_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.Language)">
      <parentCategory ref="Cat_Usage" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <enum id="Language_Value" valueName="Language" required="true">
          <item displayName="$(string.Language_auto)"><value><string>auto</string></value></item>
          <item displayName="$(string.Language_fr)"><value><string>fr</string></value></item>
          <item displayName="$(string.Language_en)"><value><string>en</string></value></item>
        </enum>
      </elements>
    </policy>
    <policy name="Theme" class="Both" displayName="$(string.Theme)" explainText="$(string.Theme_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.Theme)">
      <parentCategory ref="Cat_Usage" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <enum id="Theme_Value" valueName="Theme" required="true">
          <item displayName="$(string.Theme_auto)"><value><string>auto</string></value></item>
          <item displayName="$(string.Theme_light)"><value><string>light</string></value></item>
          <item displayName="$(string.Theme_dark)"><value><string>dark</string></value></item>
        </enum>
      </elements>
    </policy>
    <policy name="AlertLevel" class="Both" displayName="$(string.AlertLevel)" explainText="$(string.AlertLevel_Help)" key="Software\Policies\PhishGuard" presentation="$(presentation.AlertLevel)">
      <parentCategory ref="Cat_Usage" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <elements>
        <enum id="AlertLevel_Value" valueName="AlertLevel" required="true">
          <item displayName="$(string.AlertLevel_dangerous)"><value><string>dangerous</string></value></item>
          <item displayName="$(string.AlertLevel_suspicious)"><value><string>suspicious</string></value></item>
          <item displayName="$(string.AlertLevel_none)"><value><string>none</string></value></item>
        </enum>
      </elements>
    </policy>
    <policy name="AutoAnalyze" class="Both" displayName="$(string.AutoAnalyze)" explainText="$(string.AutoAnalyze_Help)" key="Software\Policies\PhishGuard" valueName="AutoAnalyze">
      <parentCategory ref="Cat_Usage" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="MoveAfterReport" class="Both" displayName="$(string.MoveAfterReport)" explainText="$(string.MoveAfterReport_Help)" key="Software\Policies\PhishGuard" valueName="MoveAfterReport">
      <parentCategory ref="Cat_Usage" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="KnownCorrespondents" class="Both" displayName="$(string.KnownCorrespondents)" explainText="$(string.KnownCorrespondents_Help)" key="Software\Policies\PhishGuard" valueName="KnownCorrespondents">
      <parentCategory ref="Cat_Usage" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="ScoreLog" class="Both" displayName="$(string.ScoreLog)" explainText="$(string.ScoreLog_Help)" key="Software\Policies\PhishGuard" valueName="ScoreLog">
      <parentCategory ref="Cat_Usage" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="AllowApiKeys" class="Both" displayName="$(string.AllowApiKeys)" explainText="$(string.AllowApiKeys_Help)" key="Software\Policies\PhishGuard" valueName="AllowApiKeys">
      <parentCategory ref="Cat_Sources" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="RedFlagEnabled" class="Both" displayName="$(string.RedFlagEnabled)" explainText="$(string.RedFlagEnabled_Help)" key="Software\Policies\PhishGuard" valueName="RedFlagEnabled">
      <parentCategory ref="Cat_Sources" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="PublicSectorList" class="Both" displayName="$(string.PublicSectorList)" explainText="$(string.PublicSectorList_Help)" key="Software\Policies\PhishGuard" valueName="PublicSectorList">
      <parentCategory ref="Cat_Sources" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="DomainAgeLookup" class="Both" displayName="$(string.DomainAgeLookup)" explainText="$(string.DomainAgeLookup_Help)" key="Software\Policies\PhishGuard" valueName="DomainAgeLookup">
      <parentCategory ref="Cat_Sources" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="BetaDnsChecks" class="Both" displayName="$(string.BetaDnsChecks)" explainText="$(string.BetaDnsChecks_Help)" key="Software\Policies\PhishGuard" valueName="BetaDnsChecks">
      <parentCategory ref="Cat_Sources" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="BetaCertAge" class="Both" displayName="$(string.BetaCertAge)" explainText="$(string.BetaCertAge_Help)" key="Software\Policies\PhishGuard" valueName="BetaCertAge">
      <parentCategory ref="Cat_Sources" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="BetaOpenPhish" class="Both" displayName="$(string.BetaOpenPhish)" explainText="$(string.BetaOpenPhish_Help)" key="Software\Policies\PhishGuard" valueName="BetaOpenPhish">
      <parentCategory ref="Cat_Sources" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="BetaTranco" class="Both" displayName="$(string.BetaTranco)" explainText="$(string.BetaTranco_Help)" key="Software\Policies\PhishGuard" valueName="BetaTranco">
      <parentCategory ref="Cat_Sources" />
      <supportedOn ref="SUPPORTED_PhishGuard" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
  </policies>
</policyDefinitions>
